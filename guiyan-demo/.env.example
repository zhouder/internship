# Optional for the maintainer only. Without this variable, npm run dev uses local SQLite.
# Set the real value in Vercel environment variables, never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Optional server-only AI integration. Blank key uses local rules.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_ENABLED=1
AI_DAILY_LIMIT=200
AI_USER_DAILY_LIMIT=40
AI_USER_MINUTE_LIMIT=6
DEEPSEEK_TIMEOUT_MS=40000
