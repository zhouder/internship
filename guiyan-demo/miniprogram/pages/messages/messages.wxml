<view class="page"><view class="row between"><view class="title">消息与私信</view><button class="small primary" bindtap="compose">发私信</button></view><button class="text" bindtap="read">全部标为已读</button><view class="panel" wx:if="{{composing}}"><view class="field"><view class="field-label">接收人</view><picker range="{{names}}" value="{{target}}" bindchange="target"><view class="picker">{{names[target]}}⌄</view></picker></view><view class="field"><view class="field-label">沟通内容</view><textarea class="textarea" value="{{content}}" bindinput="content" maxlength="1000"/></view><button class="primary" bindtap="send">发送私信</button></view><view class="panel {{!item.is_read?'notification-unread':''}}" wx:for="{{messages}}" wx:key="id"><view class="bold">{{item.title}}</view><view class="content" style="margin:18rpx 0">{{item.content}}</view><view class="muted font-small">{{item.sender_name||'平台'}} · {{item.created_at}}</view></view><view class="empty" wx:if="{{!messages.length}}">暂无消息</view></view>
