<view class="page"><view class="title">演艺资源</view><input class="search" placeholder="搜索演出、场馆、艺人或服务" value="{{keyword}}" bindinput="searchInput"/><scroll-view scroll-x class="tabs"><view class="tab {{!category?'active':''}}" data-id="" bindtap="category">全部</view><view wx:for="{{categories}}" wx:key="id" class="tab {{category===item.id?'active':''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</view></scroll-view><view class="row between"><text class="muted">共{{resources.length}}项资源</text><picker range="{{sorts}}" value="{{sort}}" bindchange="sort"><view class="picker">{{sorts[sort]}}⌄</view></picker></view><view style="height:24rpx"/><view class="resource" wx:for="{{resources}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image src="{{item.image}}" mode="aspectFill"/><view class="resource-info"><view class="resource-name">{{item.name}}</view><view class="tags"><text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view><view class="location">{{item.city}} · {{item.ratingText}}分</view><view class="price">{{item.priceText}}<text class="unit">/{{item.unit}}</text></view></view></view><view wx:if="{{!resources.length}}" class="empty">暂无符合条件的资源</view></view>
