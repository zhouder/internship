<view class="page"><view class="row between"><view class="title">需求大厅</view><button class="primary small" bindtap="create">{{creating?'收起':'发布需求'}}</button></view><view wx:if="{{creating}}" class="panel"><view class="note" wx:if="{{!user.verified}}">发布前需完成演示认证，无需真实证件。<button class="text" bindtap="verify">完成演示认证</button></view><view class="field"><view class="field-label">需求标题</view><input class="input" value="{{title}}" data-field="title" bindinput="field" maxlength="80"/></view><view class="field"><view class="field-label">分类</view><picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categoryNames[categoryIndex]}}⌄</view></picker></view><view class="field"><view class="field-label">预算（元）</view><input class="input" type="digit" value="{{budget}}" data-field="budget" bindinput="field"/></view><view class="field"><view class="field-label">城市</view><input class="input" value="{{city}}" data-field="city" bindinput="field"/></view><view class="field"><view class="field-label">需求说明</view><textarea class="textarea" maxlength="2000" value="{{description}}" data-field="description" bindinput="field"/></view><button class="primary" bindtap="submit">提交审核</button></view><view class="panel" wx:if="{{matchTitle}}"><view class="bold">匹配：{{matchTitle}}</view><view class="note">按分类、城市、预算匹配</view><view wx:for="{{matched}}" wx:key="id" data-id="{{item.id}}" bindtap="open" class="menu-item">{{item.name}}<text class="price">{{item.priceText}}</text></view><view class="note" wx:if="{{!matched.length}}">暂无符合条件的资源</view><button class="text" bindtap="closeMatch">关闭匹配</button></view><view class="panel" wx:for="{{demands}}" wx:key="id"><view class="row between"><view class="bold">{{item.title}}</view><text class="badge status-{{item.status}}">{{item.statusText}}</text></view><view class="content" style="margin:20rpx 0">{{item.description}}</view><view class="location">{{item.city}} · {{item.user_name}}</view><view class="price">预算 {{item.budgetText}}</view><view class="actions"><button class="small" data-id="{{item.id}}" bindtap="match">资源匹配</button><button wx:if="{{item.user_id!==user.id}}" class="small primary" data-id="{{item.user_id}}" bindtap="contact">联系发布方</button></view></view></view>
