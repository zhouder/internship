<view wx:if="{{r}}"><image style="width:100%;height:400rpx" src="{{r.image}}" mode="aspectFill"/><view class="page"><view class="row between"><view class="title">{{r.name}}</view><button class="text" bindtap="favorite">{{favorite?'♥ 已收藏':'♡ 收藏'}}</button></view><view class="location">{{r.city}} · {{r.ratingText}}分 · 图片为演示示意图</view><view class="price">{{r.priceText}}<text class="unit">/{{r.unit}}</text></view><view class="tabs"><view class="tab {{tab==='detail'?'active':''}}" data-tab="detail" bindtap="tab">资源介绍</view><view class="tab {{tab==='book'?'active':''}}" data-tab="book" bindtap="tab">档期与预约</view><view class="tab {{tab==='comments'?'active':''}}" data-tab="comments" bindtap="tab">评分评论</view></view>
<view wx:if="{{tab==='detail'}}"><view class="panel content">{{r.description}}</view><view class="panel" wx:for="{{r.metaRows}}" wx:key="key"><view class="muted">{{item.key}}</view><view class="content">{{item.value}}</view></view><view class="panel" wx:if="{{r.category==='equipment'}}"><view class="bold">舞台灯位示意（模拟）</view><view style="height:250rpx;background:#162b41;display:flex;align-items:center;justify-content:center;margin:20rpx 0;overflow:hidden"><view style="width:330rpx;height:150rpx;border:6rpx solid #98d4b9;color:white;text-align:center;line-height:150rpx;background:{{light?'#7386bc':'#27836e'}};transform:rotate({{angle}}deg)">●　●　●</view></view><button class="small" bindtap="rotate">旋转舞台 / 切换灯色</button><view class="note">示意演示，不进行真实设备仿真。</view></view><view class="panel" wx:if="{{r.category==='digital'}}"><button class="primary" bindtap="play">{{playing?'暂停模拟点播':'开始模拟点播'}}</button><progress percent="{{progress}}" activeColor="#087f72" style="margin-top:20rpx"/><view class="note">仅模拟播放进度，无真实视频流。</view></view><button class="primary" data-tab="book" bindtap="tab">选择日期，提交预约</button></view>
<view wx:if="{{tab==='book'}}" class="panel"><view class="note">预约通过后台确认后，可进行模拟支付。场馆和设备按天独占预约。</view><view wx:if="{{rental}}"><view class="field-label">已有占用档期</view><view class="calendar"><text wx:for="{{dates}}" wx:key="index">{{item.booking_date}}</text><text wx:if="{{!dates.length}}">暂无占用</text></view></view><view class="field" style="margin-top:24rpx"><view class="field-label">预约日期</view><picker mode="date" value="{{date}}" start="2026-11-09" bindchange="date"><view class="picker">{{date}}⌄</view></picker></view><view class="field"><view class="field-label">数量{{rental?'（租赁为1）':''}}</view><input class="input" type="number" value="{{quantity}}" disabled="{{rental}}" bindinput="quantity"/></view><view class="field"><view class="field-label">备注 / 定制要求</view><textarea class="textarea" maxlength="1000" value="{{note}}" bindinput="note"/></view><view class="row between"><text>合计</text><text class="price">{{total}}</text></view><view class="note">不收取真实费用，支付、合同与权益均为模拟。</view><button class="primary" bindtap="book">提交预约</button></view>
<view wx:if="{{tab==='comments'}}"><view class="panel" wx:for="{{comments}}" wx:key="id"><view class="row between"><text class="bold">{{item.user_name}}</text><text class="price">{{item.rating}}分</text></view><view class="content">{{item.content}}</view><view class="note" wx:if="{{item.reply}}">平台回复：{{item.reply}}</view></view><view class="panel"><view class="field-label">质量评分</view><picker range="{{ratings}}" value="{{rating-1}}" bindchange="rating"><view class="picker">{{rating}}分⌄</view></picker><view class="field-label">服务体验</view><picker range="{{ratings}}" value="{{serviceRating-1}}" data-field="serviceRating" bindchange="dimension"><view class="picker">{{serviceRating}}分⌄</view></picker><view class="field-label">体验价值</view><picker range="{{ratings}}" value="{{valueRating-1}}" data-field="valueRating" bindchange="dimension"><view class="picker">{{valueRating}}分⌄</view></picker><view class="field" style="margin-top:24rpx"><view class="field-label">分享体验</view><textarea class="textarea" value="{{comment}}" maxlength="1000" bindinput="comment"/></view><button class="primary" bindtap="review">提交评论，等待审核</button></view></view></view></view><view wx:else class="empty">正在加载资源…</view>
