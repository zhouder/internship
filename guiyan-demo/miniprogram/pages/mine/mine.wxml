<view wx:if="{{user}}"><view class="profile-head"><view class="avatar">桂</view><view><view class="title" style="margin:0">{{user.name}}</view><view class="muted">{{user.city}} · {{user.role==='supplier'?'资源合作方':'文化体验者'}}</view></view><text class="badge">{{user.verified?'演示已认证':'未认证'}}</text></view><view class="menu-item" data-page="orders" bindtap="navigate">我的订单<text>{{orders}} ›</text></view><view class="menu-item" bindtap="favorites">我的收藏<text>{{favorites.length}} ›</text></view><view class="menu-item" data-page="messages" bindtap="navigate">消息与私信<text>{{messages}}未读 ›</text></view><view class="menu-item" data-page="assistant" bindtap="navigate">智能客服与文案助手<text>›</text></view><view class="menu-item" bindtap="edit">个人资料与偏好<text>›</text></view><view class="menu-item" bindtap="verify">演示身份认证<text>无需真实证件 ›</text></view><view class="page"><view wx:if="{{showFavorites}}"><view class="section-title">我的收藏</view><view wx:for="{{favorites}}" wx:key="id" class="resource" data-id="{{item.id}}" bindtap="open"><image src="{{item.image}}" mode="aspectFill"/><view><view class="resource-name">{{item.name}}</view><view class="price">{{item.priceText}}</view></view></view><view class="empty" wx:if="{{!favorites.length}}">暂无收藏</view></view><view class="panel" wx:if="{{editing}}"><view class="field"><view class="field-label">昵称</view><input class="input" value="{{name}}" data-field="name" bindinput="field"/></view><view class="field"><view class="field-label">城市</view><input class="input" value="{{city}}" data-field="city" bindinput="field"/></view><view class="field"><view class="field-label">兴趣偏好</view><picker range="{{categoryNames}}" value="{{preferenceIndex}}" bindchange="preference"><view class="picker">{{categoryNames[preferenceIndex]}}⌄</view></picker></view><button class="primary" bindtap="save">保存偏好</button></view><button bindtap="logout">退出登录</button><view class="note">所有身份、订单、AI、支付及对接结果均为模拟。原生小程序与H5、后台共用本地业务数据。</view></view></view><view wx:else class="page" style="text-align:center;padding-top:130rpx"><view class="title">登录，发现更多好戏</view><view class="note">收藏资源，管理预约与合作需求</view><button class="primary" bindtap="login">登录 / 注册</button></view>
