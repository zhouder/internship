<view class="page"><view class="title">我的订单</view><picker range="{{statusNames}}" value="{{status}}" bindchange="status"><view class="picker">{{statusNames[status]}}⌄</view></picker><view style="height:22rpx"/><view class="panel" wx:for="{{orders}}" wx:key="id"><view class="row between"><text class="muted font-small">{{item.code}}</text><text class="badge status-{{item.status}}">{{item.statusText}}</text></view><view class="row" style="margin:24rpx 0"><image class="order-image" src="{{item.image}}" mode="aspectFill"/><view style="flex:1"><view class="bold">{{item.resource_name}}</view><view class="location">{{item.booking_date}} · {{item.quantity}}{{item.unit}}</view><view class="price">{{item.amountText}}</view></view></view><view class="muted">资金：{{item.escrow}} · 渠道：{{item.channel}}</view><view wx:if="{{item.category==='creative' && (item.status==='paid'||item.status==='completed')}}" class="note">模拟物流：运输中 · DEMO{{item.id}}</view><view class="note" wx:if="{{item.refund_reason}}">售后原因：{{item.refund_reason}}</view><view class="actions"><button wx:if="{{item.status==='confirmed'}}" class="small primary" data-id="{{item.id}}" data-action="pay" bindtap="action">模拟支付</button><button wx:if="{{item.status==='pending'||item.status==='confirmed'}}" class="small" data-id="{{item.id}}" data-action="cancel" bindtap="action">取消预约</button><block wx:if="{{item.status==='paid'}}"><button class="small primary" data-id="{{item.id}}" data-action="complete" bindtap="action">确认完成</button><button class="small" data-id="{{item.id}}" data-action="refund" bindtap="action">申请退款</button><button class="small" data-id="{{item.id}}" data-action="dispute" bindtap="action">提交申诉</button></block><button class="small" data-id="{{item.id}}" bindtap="contract">协议 / 权益</button></view></view><view class="empty" wx:if="{{!orders.length}}">暂无订单</view></view>
