<view class="page"><view class="title">智能客服与文案</view><view class="tabs"><view class="tab {{kind==='support'?'active':''}}" data-kind="support" bindtap="kind">智能客服</view><view class="tab {{kind==='copy'?'active':''}}" data-kind="copy" bindtap="kind">文案生成</view></view><view class="badge">本地规则与模板模拟</view><view wx:for="{{messages}}" wx:key="index" class="chat-message {{item.role}}">{{item.content}}</view><view wx:if="{{busy}}" class="muted">正在整理回答…</view><view class="panel"><input class="input" value="{{prompt}}" maxlength="1000" placeholder="输入订单问题或文案主题" bindinput="input" bindconfirm="submit"/><view class="actions"><button class="primary small" bindtap="submit" disabled="{{busy}}">发送问题</button><button class="small" bindtap="quick" data-prompt="如何申请退款或改签？">退票改签</button><button class="small" bindtap="quick" data-prompt="帮我查询订单">查询订单</button></view></view></view>
